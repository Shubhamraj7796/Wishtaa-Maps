# Copy to .env (never commit .env). Browser-safe values only get the VITE_ prefix.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google Drive (see docs/google-drive-setup.md). Both are public by design; restrict them to your site addresses in Google Cloud.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Server-only (Vercel functions). Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
